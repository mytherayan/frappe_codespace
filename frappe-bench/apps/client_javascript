Client script
Here are the **client-side scripts** separated from the client-side (browser) in ERPNext:

### **1. Employee List Settings (List View Script)**
```javascript
frappe.listview_settings['Employee'] = {
    onload: function(listview) {
        console.log(frappe.session.user);
        listview.page.add_inner_button('Filter My Entries', function() {
            // Filter based on ownership of the logged-in user
            listview.filter_area.add([["Employee", "owner", "=", frappe.session.user]]);
            listview.refresh();
        });

        // Apply the filter on page load
        listview.filter_area.add([["Employee", "owner", "=", frappe.session.user]]);
        listview.refresh();

        if(frappe.session.user == 'onedata@admin.com'){
            listview.page.wrapper.find('.filter-area').hide();
            listview.page.wrapper.find('.filter-button').hide();
            listview.page.wrapper.find('.filter-x-button').hide();
        }
    }
};
```

### **2. Employee Self Edit (Form Script)**
```javascript
frappe.ui.form.on('Employee', {
    setup: function(frm) {
        frappe.call({
            method: "frappe.client.get_value",
            args: {
                doctype: "User",
                filters: { "name": frappe.session.user },
                fieldname: "roles"
            },
            callback: function(response) {
                if (response.message) {
                    let roles = response.message.roles;
                    if (roles.includes("onedata") && !roles.includes("HR Manager")) {
                        frm.set_query("name", function() {
                            return {
                                filters: { "owner": frappe.session.user }
                            };
                        });
                    }
                }
            }
        });
    }
});
```

### **3. Event Mail (Form Script)**
```javascript
frappe.ui.form.on("Event", {
    refresh: function (frm) {
        frm.add_custom_button("Send Reminder Now", function () {
            frappe.call({
                method: "frappe.core.doctype.communication.email.make",
                args: {
                    recipients: frm.doc.owner,
                    subject: `Reminder: Upcoming Event ${frm.doc.name}`,
                    content: `Your event '${frm.doc.name}' is scheduled soon. Don't forget to attend!`
                },
                callback: function () {
                    frappe.msgprint("Reminder Sent Successfully!");
                }
            });
        });
        
        frm.add_custom_button("Send Notification", function () {
            frappe.call({
                method: "erpnext.send_notification.send_notification",
                args: {
                    event_name: frm.doc.name,
                    recipient: frm.doc.owner
                },
                callback: function () {
                    frappe.msgprint("Reminder sent as an in-app notification!");
                }
            });
        });
    }
});
```

