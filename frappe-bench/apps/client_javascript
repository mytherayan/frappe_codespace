### **5. Lead Convert to Customer (List View Script)**
```javascript
frappe.listview_settings['Lead'] = {
    onload: function (listview) {
        listview.page.add_action_item(__('Convert to Customer'), function () {
            let selected = listview.get_checked_items().map(d => d.name); // Get selected lead names
            if (selected.length === 0) {
                frappe.msgprint(__('Please select at least one Lead.'));
                return;
            }

            frappe.call({
                method: "erpnext.onedata.bulk_convert_leads_to_customers",
                args: { leads: JSON.stringify(selected) },
                callback: function (r) {
                    if (r.message) {
                        let successCount = r.message.success.length;
                        let errorCount = r.message.errors.length;

                        frappe.msgprint(`${successCount} Leads converted to Customers.`);
                        if (errorCount > 0) {
                            frappe.msgprint(`Errors: ${r.message.errors.join(", ")}`);
                        }

                        listview.refresh(); // Refresh the list view
                    }
                }
            });
        });
    }
};
```

### **6. Lead Number Restrict (Form Script)**
```javascript
frappe.ui.form.on("Lead", {
    validate: function(frm) {
        let phone = (frm.doc.phone || "").trim();
        if (!phone.startsWith("+")) {
            frappe.msgprint({
                title: "Invalid Phone Number",
                message: "Phone number must start with a '+' followed by the country code.",
                indicator: "red"
            });
            frappe.validated = false;
            return;
        }

        let digitsOnly = phone.replace(/\D/g, "");
        if (digitsOnly.length < 8 || digitsOnly.length > 15) {
            frappe.msgprint({
                title: "Invalid Phone Number",
                message: "Phone number must be between 8 to 15 digits (excluding the '+').",
                indicator: "red"
            });
            frappe.validated = false;
        }
    }
});
```

### **7. Weather Data Fetch (List View Script)**
```javascript
frappe.listview_settings['Weather Data'] = {
    onload: function(listview) {
        // Ensure the button is only added once
        if (!listview.fetch_weather_button) {
            listview.fetch_weather_button = listview.page.add_button('Fetch Weather', function() {
                frappe.call({
                    method: "erpnext.weather_data.fetch_weather",
                    callback: function(response) {
                        if (response.message) {
                            frappe.msgprint({
                                title: "Weather Data Updated",
                                message: "Weather data has been successfully fetched!",
                                indicator: "green"
                            });
                            listview.refresh();
                        } else {
                            frappe.msgprint({
                                title: "Error",
                                message: "Failed to fetch weather data. Please check logs.",
                                indicator: "red"
                            });
                        }
                    }
                });
            });

            listview.fetch_weather_button.addClass("btn-primary"); // Highlight the button
        }
    }
};
```
